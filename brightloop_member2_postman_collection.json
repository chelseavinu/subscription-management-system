{
  "info": {
    "name": "Brightloop - Member 2 (Logic & Billing Engine)",
    "_postman_id": "b3e0e7a1-2291-4c6b-9c71-f925f3c9b4e2",
    "description": "Complete API collection for Subscriptions, State Transitions, Automated Billing Day, Invoicing, Payments and Discounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Subscriptions & Quotes",
      "item": [
        {
          "name": "List All Subscriptions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/subscriptions?status=active",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "subscriptions"],
              "query": [{ "key": "status", "value": "active" }]
            }
          }
        },
        {
          "name": "Calculate Quote Preview",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_name\": \"Brightloop Business ERP Suite\",\n      \"variant\": { \"name\": \"Brand\", \"option\": \"Odoo Connected\", \"extra_price\": 560 },\n      \"quantity\": 2,\n      \"unit_price\": 1200,\n      \"tax_pct\": 10\n    }\n  ],\n  \"discount_code\": \"LAUNCH20\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/subscriptions/calculate-preview",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "subscriptions", "calculate-preview"]
            }
          }
        },
        {
          "name": "Transition Subscription Status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"reason\": \"Customer agreed to quotation proposal\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/subscriptions/:id/transition",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "subscriptions", ":id", "transition"],
              "variable": [{ "key": "id", "value": "SUBSCRIPTION_ID_HERE" }]
            }
          }
        },
        {
          "name": "Renew Subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"months\": 12\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/subscriptions/:id/renew",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "subscriptions", ":id", "renew"],
              "variable": [{ "key": "id", "value": "SUBSCRIPTION_ID_HERE" }]
            }
          }
        }
      ]
    },
    {
